FROM python:3.13-slim

ARG BUILD_ENV=production
ARG APP_VERSION=1.0.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=${BUILD_ENV} \
    APP_VERSION=${APP_VERSION} \
    MALLOC_ARENA_MAX=2 \
    PATH="/home/appuser/.local/bin:$PATH"

WORKDIR /app

# Step 4: Install system build dependencies (cleaned up in same layer to keep image small)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Step 5: Create a non-root user for security
RUN useradd --create-home --shell /bin/bash appuser

# Step 6: Install dependencies as the non-root user (Leverages Docker layer caching)
COPY --chown=appuser:appuser requirements.txt .
USER appuser
RUN pip install --no-cache-dir --user -r requirements.txt

# Step 7: Copy application source code
COPY --chown=appuser:appuser . .

EXPOSE 8000

# Step 8. Container Health Check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.app:app", "--host", "0.0.0.0", "--port", "8000"]