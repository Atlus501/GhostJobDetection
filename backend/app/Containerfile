FROM python:3.13-slim

ARG BUILD_ENV=production
ARG APP_VERSION=1.0.0

# 1. Set working directory to /app and give appuser ownership before switching users
WORKDIR /app

# 2. Environment variables (PYTHONPATH=/app ensures root modules like config resolve smoothly)
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=${BUILD_ENV} \
    APP_VERSION=${APP_VERSION} \
    MALLOC_ARENA_MAX=2 \
    PATH="/home/appuser/.local/bin:$PATH"

# 3. System build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 4. Copy requirements file into /app and install dependencies as appuser (Caching layer)
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy all application files directly into /app (Uses . . because WORKDIR is /app)
COPY . .

EXPOSE 8000

# 6. Container Health Check (Make sure @app.get("/health") exists in FastAPI, or remove this block)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:443/health || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]

#use the below CMD instead of the above one if one is planning to use gunicorn
#please note that gunicorn is unusable on windows os
#CMD ["gunicorn", "-c", "./config/gunicorn_config.py", "app:app"]